{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "soma-cockpit",
  "version": "0.1.0",
  "identifier": "com.hyt.soma-cockpit",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "soma cockpit",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}
